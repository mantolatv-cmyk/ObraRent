{
    "name": "@obra-rent/backend",
    "version": "1.0.0",
    "description": "Mantovani API - Construction equipment rental platform",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:dev": "tsx --env-file-if-exists=.env src/db/dev-server.ts",
        "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
        "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
        "db:reset": "tsx --env-file-if-exists=.env src/db/migrate.ts --reset && tsx --env-file-if-exists=.env src/db/seed.ts"
    },
    "author": "",
    "license": "UNLICENSED",
    "type": "commonjs",
    "dependencies": {
        "axios": "^1.21.1",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "qrcode": "^1.5.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.16",
        "@electric-sql/pglite-socket": "^0.2.19",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^7.2.1",
        "pino-pretty": "^13.2.0",
        "supertest": "^7.3.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12"
    },
    "private": true,
    "engines": {
        "node": ">=20"
    }
}
