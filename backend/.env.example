NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection (use `npm run db:dev` for zero-install PGlite, or docker-compose up -d)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mantovani_rental
DB_POOL_MAX=1
DB_SSL=false

CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Rental rules & dynamic freight
PAYMENT_HOLD_MINUTES=30
MAX_RENTAL_DAYS=180
DEPOT_CEP=01001000
DEPOT_LATITUDE=-23.5503
DEPOT_LONGITUDE=-46.6339
FREIGHT_BASE=80
FREIGHT_PER_KM=2.5
FREIGHT_PER_EXTRA_UNIT=15

# Payment Gateway ('mock' | 'asaas')
PAYMENT_GATEWAY=mock
GATEWAY_WEBHOOK_TOKEN=dev-gateway-webhook-token
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
PIX_KEY=52342052000140
PIX_MERCHANT_NAME=MAQUINAS PARA CONCRETO
PIX_MERCHANT_CITY=ATIBAIA
PIX_MERCHANT_CEP=12944430

# External CEP lookup (ViaCEP)
CEP_LOOKUP_URL=https://viacep.com.br/ws

# WhatsApp integration ('console' | 'evolution' | 'meta')
MESSAGING_PROVIDER=console
# WHATSAPP_WEBHOOK_TOKEN=
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=mantovani
# META_GRAPH_URL=https://graph.facebook.com/v21.0
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# META_VERIFY_TOKEN=
